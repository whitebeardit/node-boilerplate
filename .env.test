PORT=3000
NODE_ENV=TEST

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# DYNAMODB_ENDPOINT is set by jest/start-integration.ts (in-memory dynalite)
DYNAMODB_USERS_TABLE=users
# The SQS client is mocked in tests (aws-sdk-client-mock); any well-formed URL
SQS_USER_NEW_QUEUE_URL=http://localhost/000000000000/user-new-test
SQS_USER_NEW_DLQ_ARN=arn:aws:sqs:us-east-1:000000000000:user-new-dlq-test

OTEL_SDK_DISABLED=true
