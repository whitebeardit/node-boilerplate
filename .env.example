# HTTP server
PORT=3000
NODE_ENV=DEV

# DynamoDB
AWS_REGION=us-east-1
# Point to a local DynamoDB for development, e.g.:
#   docker run -p 8000:8000 amazon/dynamodb-local
# Leave DYNAMODB_ENDPOINT unset to use real AWS (credentials from the default chain)
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_USERS_TABLE=users
# Email uniqueness guard table (claimed before each user write)
DYNAMODB_USERS_EMAIL_TABLE=users-email

# SQS
# Queue consumed for USER.NEW events (required — boot fails without it).
# Production contract is a FIFO queue: the producer sets
# MessageGroupId/MessageDeduplicationId = user id (5-minute dedup window,
# per-user ordering). A standard queue also works — idempotency is still
# guaranteed at the storage level.
SQS_USER_NEW_QUEUE_URL=http://localhost:9324/000000000000/user-new.fifo
# ARN of the USER.NEW dead-letter queue (required — used by POST /ops/user-new/redrive).
# A FIFO queue's DLQ must itself be FIFO.
SQS_USER_NEW_DLQ_ARN=arn:aws:sqs:us-east-1:000000000000:user-new-dlq.fifo
# Point to a local SQS for development, e.g.:
#   docker run -p 9324:9324 softwaremill/elasticmq-native
# Leave SQS_ENDPOINT unset to use real AWS (credentials from the default chain)
SQS_ENDPOINT=http://localhost:9324

# OpenTelemetry
# Set to 'true' to disable tracing entirely (it is disabled in tests via .env.test)
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=node-boilerplate
# OTLP HTTP endpoint of your collector (Jaeger, Grafana Tempo, etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
