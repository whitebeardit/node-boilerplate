# HTTP server
PORT=3000
NODE_ENV=DEV

# DynamoDB
AWS_REGION=us-east-1
# Point to a local DynamoDB for development, e.g.:
#   docker run -p 8000:8000 amazon/dynamodb-local
# Leave DYNAMODB_ENDPOINT unset to use real AWS (credentials from the default chain)
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
DYNAMODB_USERS_TABLE=users

# OpenTelemetry
# Set to 'true' to disable tracing entirely (it is disabled in tests via .env.test)
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=node-boilerplate
# OTLP HTTP endpoint of your collector (Jaeger, Grafana Tempo, etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
